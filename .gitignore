# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Real datasets: never committed, never redistributed (download scripts only)
data/real/

# Synthetic dataset: regenerated from the seed (see docs/data_card.md); only manifests are kept
data/synthetic/**
!data/synthetic/
!data/synthetic/.gitkeep
!data/synthetic/*/
!data/synthetic/*/manifest.json

# Scratch
*.log
.DS_Store
Thumbs.db

# Local working notes, kept out of the public repo (docs/decisions.md D-003)
CLAUDE.md
BUILD_PROMPT.md
.claude/

# Derived features and trained models (rebuilt with one command each)
data/features/
models/artifacts/
results/models/test_predictions.parquet

# Dashboard demo cache (rebuilt with `uv run python -m dashboard.prepare`)
data/demo/*
!data/demo/.gitkeep
